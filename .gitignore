# Dependencies
node_modules/

# Environment and local secrets
.env
.env.local
.env.*.local
.deploy.env
.deploy-docker.env
!.env.example
!.deploy-docker.env.example

# Build, cache, and coverage output
# Anchored to the actual generated output dirs only — a bare "build/" also matched
# client/config/build/ (real webpack config source), silently excluding it from git.
/client/build/
/server/build/
/server/public/telegram-admin/
dist/
coverage/
playwright-report/
test-results/
playwright/.auth/
.cache/
.turbo/
.eslintcache
*.tsbuildinfo
graphify-out/

# Generated CSS and source maps (compiled from SCSS)
client/src/**/*.css
client/src/**/*.css.map

# i18n parser artifacts (real translations live in client/public/locales)
client/extractedTranslations/

# Logs and runtime files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local data and backups
backups/
deploy/
server/src/data/*.json
server/knowledge/
photo/
docs/*.png
docs/*.jpg
docs/*.jpeg
*.xlsx
*.pdf
*.sqlite
*.sqlite3
*.db

# Internal planning and security-review docs (not published)
docs/roadmap/
docs/security/
docs/adr/

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local agent/tooling state
.claude/settings.local.json
