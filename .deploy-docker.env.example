# Скопируйте в .deploy-docker.env и укажите SSH-адрес сервера.
# Production работает как единственный live Docker stack.
DEPLOY_HOST=root@SERVER_IP

# Домен админки: под него scripts/deploy-setup.sh ставит сайт nginx и выпускает TLS-сертификат.
DEPLOY_DOMAIN=hhdc.example.com

# Путь на сервере для production Docker-стека.
REMOTE_PATH=/var/www/project/hhdc

# Loopback-порты стека: nginx на хосте проксирует на них, deploy проверяет по ним готовность.
BACKEND_PORT_PROD=38090
FRONTEND_PORT_PROD=3040
