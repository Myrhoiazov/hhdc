# Скопируйте в .deploy-docker.env и укажите SSH-адрес сервера.
# Production сейчас работает как единственный live Docker stack.
DEPLOY_HOST=root@SERVER_IP

# Путь на сервере для production Docker-стека.
REMOTE_PATH=/var/www/project/hhdc_docker_prod

# Порты для smoke-check после деплоя.
BACKEND_PORT_PROD=38080
FRONTEND_PORT_PROD=3030
