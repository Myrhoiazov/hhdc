# Host nginx (VPS) site for the HHDC Admin Docker stack. Rendered and installed by
# scripts/deploy-setup.sh, which fills in the domain and the two loopback ports.
#
# The site starts as plain HTTP on purpose: `certbot --nginx` then issues the certificate and
# adds the 443 server block and the redirect to this file on the server. For that reason the
# installed copy in /etc/nginx/sites-available is never overwritten by a later deploy.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # An email reply carries up to 5 attachments of 10 MB each; leave room for multipart overhead.
    client_max_body_size 60m;

    location ~ /\.(?!well-known) {
        deny all;
    }

    location /api {
        proxy_pass http://127.0.0.1:__BACKEND_PORT__;
        proxy_http_version 1.1;
        # AI drafts and knowledge-base loads answer slowly; the default 60s cuts them off.
        proxy_read_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:__FRONTEND_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
