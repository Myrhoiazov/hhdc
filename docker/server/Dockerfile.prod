FROM node:20-alpine AS build

RUN apk add --no-cache openssl python3 make g++

WORKDIR /app

COPY package*.json ./
COPY tsconfig.json ./
COPY prisma.config.ts ./
COPY prisma ./prisma/

RUN npm ci
RUN npx prisma generate --schema ./prisma/schema

COPY src ./src/

RUN npm run build

FROM node:20-alpine AS runner

# openssl is required by Prisma's query engine; python3/make/g++ to rebuild
# argon2 for the runtime arch (npm ci --omit=dev still runs argon2's postinstall).
RUN apk add --no-cache openssl python3 make g++

WORKDIR /app

COPY package*.json ./
COPY tsconfig.json ./
COPY prisma.config.ts ./
COPY prisma ./prisma/
RUN npm ci --omit=dev
RUN npx prisma generate --schema ./prisma/schema

COPY --from=build /app/build ./build

RUN mkdir -p private-uploads

EXPOSE 8080

# Pending migrations are applied on every start, then the compiled entrypoint runs.
CMD ["sh", "-c", "npx prisma migrate deploy --schema ./prisma/schema && node build/src/index.js"]
