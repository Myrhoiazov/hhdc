# PostgreSQL CRM uses a new volume. Existing MySQL volumes are untouched.
POSTGRES_DB=hhdc_crm
POSTGRES_USER=hhdc
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_PORT=55433
POSTGRES_CONTAINER_NAME=hhdc-postgres
DATABASE_URL=postgresql://hhdc:change_me_db_password@127.0.0.1:55433/hhdc_crm?schema=public

# Owner provisioning is explicit. No customer/demo data is seeded by default.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Owner
SEED_DEMO=false
E2E_DATABASE_PASSWORD=

# Generate SESSION_SECRET securely (at least 32 characters).
# APP_ENCRYPTION_KEY must be a base64 encoded random 32-byte key.
SESSION_SECRET=
APP_ENCRYPTION_KEY=
NODE_ENV=development
MODE=development
COOKIE_NAME=hhdc_session
PORT=8080

FRONTEND_PORT=3011
BACKEND_PORT=18090
FRONTEND_PORT_PROD=3040
BACKEND_PORT_PROD=38090
FRONTEND_CONTAINER_NAME=hhdc-client-live
BACKEND_CONTAINER_NAME=hhdc-backend-live
REDIS_CONTAINER_NAME=hhdc-redis
CLIENT_URL=http://localhost:3011
PUBLIC_SITE_URL=http://localhost:18090
CLIENT_API_URL=http://localhost:18090
CLIENT_URL_PROD=https://hhdc.example.com
PUBLIC_SITE_URL_PROD=https://hhdc.example.com
CLIENT_API_URL_PROD=https://hhdc.example.com

REDIS_PORT=16391
REDIS_PASSWORD=change_me_redis_password
OLLAMA_CONTAINER_NAME=hhdc-ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_MEM_LIMIT=2g
OLLAMA_CPU_LIMIT=1.5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=
OPENAI_ALLOWED_MODELS=
OPENAI_CONTEXT_LENGTH=16000
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:18090/api/v1/providers/gmail/callback
WEEZTIX_BASE_URL=
# OAuth client from Weeztix (Company settings -> OAuth clients). The redirect has to be exactly the one saved there.
WEEZTIX_CLIENT_ID=
WEEZTIX_CLIENT_SECRET=
WEEZTIX_REDIRECT_URI=

# The edition customers ask about by default; facts published for another year are legacy.
HHDC_EVENT_YEAR=2027
# Knowledge-base folders loaded by "Load knowledge base", comma separated.
RAG_KNOWLEDGE_PATH=knowledge/hhdc-knowledge-v1,knowledge/hhdc-knowledge-v2
# Upper bound for one request to the AI provider; raise it for a local model running on CPU.
AI_REQUEST_TIMEOUT_MS=60000
LLM_CONTEXT_LENGTH=2048
LLM_TEMPERATURE=0.2
LLM_KEEP_ALIVE=0
AI_MAX_CONCURRENCY=1
AI_EMAIL_CLASSIFICATION_ENABLED=false
AI_EMAIL_DRAFT_ENABLED=false
AI_EMAIL_SEND_ENABLED=false
KNOWLEDGE_SYNC_ENABLED=false
KNOWLEDGE_BASE_URL=
KNOWLEDGE_ALLOWED_DOMAINS=
KNOWLEDGE_CANONICAL_LANGUAGE=en
RAG_TOP_K=4
RAG_QUERY_EXPANSION_ENABLED=false
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=qwen3-reranker:0.6b
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100

# Background workers (outbox, automations, campaigns, outbound webhooks).
# The web process polls by default; set BACKGROUND_WORKERS=off there when a dedicated
# worker runs `npm --prefix server run start:worker`.
BACKGROUND_WORKERS=on
WORKER_POLL_MS=5000
# Connected mailboxes are polled for new mail by the background worker.
EMAIL_SYNC_ENABLED=true
EMAIL_SYNC_INTERVAL_MS=300000
# Weeztix is polled for new events, prices and orders by the background worker (default: every 10 minutes).
WEEZTIX_SYNC_ENABLED=true
WEEZTIX_SYNC_INTERVAL_MS=600000
# Existing bot credentials can deliver privacy-safe email operations alerts to this chat.
TELEGRAM_TOKEN=
# Numeric chat id, e.g. -1001234567890; notifications stay off while it is empty.
TELEGRAM_EMAIL_NOTIFY_CHAT_ID=
# AI drafts of replies are posted to the same chat with Send / Reject / Spam buttons.
# The bot must be HHDC's own: a bot that already has a webhook elsewhere cannot deliver the presses here.
AI_EMAIL_TELEGRAM_APPROVAL_ENABLED=true
# Who may press the buttons: Telegram user id and the CRM login of that person, comma separated.
# A press by anyone else is refused and tells them their id. Example: 123456789:inna@example.com
TELEGRAM_APPROVERS=
# Private files (choreographer photos, later documents). Relative to the server working directory.
STORAGE_ROOT=private-uploads
