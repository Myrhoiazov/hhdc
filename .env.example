# Скопируйте в .env и заполните реальными значениями перед запуском docker compose.
# Локальный dev-стек и prod-стек читают один и тот же .env — переменные с суффиксом
# *_PROD относятся только к docker-compose.prod.yml.

# ---- MySQL (docker-compose.yml) ----
DB_ROOT_PASSWORD=change_me_root_password
DB_NAME=hhdc
DB_USER=hhdc
DB_PASSWORD=change_me_db_password
DB_PORT=33072

# ---- Redis (docker-compose.yml) ----
REDIS_PORT=16391
REDIS_PASSWORD=change_me_redis_password
OLLAMA_PORT=11434
OLLAMA_CONTAINER_NAME=hhdc-ollama

# ---- Порты (docker-compose.dev.yml / docker-compose.prod.yml) ----
FRONTEND_PORT=3011
BACKEND_PORT=18090
FRONTEND_PORT_PROD=3040
BACKEND_PORT_PROD=38090

# Production container names. Keep these aligned with host nginx and DEPLOY.md.
FRONTEND_CONTAINER_NAME=hhdc-client-live
BACKEND_CONTAINER_NAME=hhdc-backend-live
DB_CONTAINER_NAME=hhdc-mysql-live
REDIS_CONTAINER_NAME=hhdc-redis-live

# ---- URL-ы ----
CLIENT_URL=http://localhost:3010
PUBLIC_SITE_URL=http://localhost:18090
CLIENT_API_URL=http://localhost:18090
CLIENT_URL_PROD=https://hhdc.example.com
PUBLIC_SITE_URL_PROD=https://talentcenter.example.com
CLIENT_API_URL_PROD=https://hhdc.example.com

# ---- Backend-секреты (server/.env сейчас) ----
JWT_ACCESS_SECRET=change_me_jwt_access_secret
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret
SECRET_SALT=change_me_secret_salt
CSRF_SECRET=change_me_csrf_secret
VERIFY_MARKER_SECRET=change_me_verify_marker_secret
COOKIE_NAME=sid
COOKIE_NAME_MOLLIE=mollie_sid
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=30d
TWO_FACTOR_SENDER_EMAIL=

# Cloudflare Turnstile — required to require a captcha after repeated failed
# logins (middleware.LoginRateLimit.ts). Login rate limiting still works
# without these set; the captcha step is simply skipped.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Mollie ----
MOLLIE_API_KEY=
MOLLIE_CLIENT_ID=
MOLLIE_CLIENT_SECRET=
MOLLIE_REDIRECT_URI=
MOLLIE_URI=
MOLLIE_WEBHOOK_URL=

# ---- Instagram ----
INSTAGRAM_ID=
INSTAGRAM_WEB_HOOK=
INSTGRAM_MARKER=
INSTGRAM_SECRET=

# ---- Telegram (outbound admin notifications — payment/security alerts) ----
TELEGRAM_CHAT_ID=
# Personal chat id for a single admin's own private new-email pings — separate from
# TELEGRAM_CHAT_ID (the shared group all other notify*() functions in telegram.service.ts use).
# Same numeric-id space as TELEGRAM_CHAT_ID's members; must be a chat the bot can already message
# (i.e. that person has started a private conversation with the bot at least once).
TELEGRAM_EMAIL_NOTIFY_CHAT_ID=
TELEGRAM_APPROVER_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TOKEN=
# Local-dev alternative to the webhook (no public URL/tunnel needed): the server pulls updates
# from Telegram via getUpdates instead of Telegram pushing them to us. Mutually exclusive with a
# registered webhook — delete the webhook (bot<token>/deleteWebhook) before enabling this.
TELEGRAM_POLLING_ENABLED=false
# Public URL of the built Telegram Mini App bundle (server/public/telegram-admin/index.html,
# built by client/telegram-mini-app). Used both for the admin bot's /start root-menu web_app
# buttons (telegram-admin-bot.menu.ts) and for the bot's Menu Button (setChatMenuButton).
TELEGRAM_MINIAPP_URL=
# @username of the TELEGRAM_TOKEN bot (no leading @, from BotFather). Telegram rejects `web_app`
# inline buttons everywhere except a private 1:1 chat with the bot, so when /start is used from
# a group (e.g. TELEGRAM_CHAT_ID's admin group), the bot replies with a plain t.me/<username>
# deep link into a private chat instead — see telegram-admin-bot.menu.ts.
TELEGRAM_BOT_USERNAME=

# ---- Telegram Login (OIDC, ADMIN-only auth provider — separate from the bot above) ----
# Obtained via @BotFather's Login Widget section for the bot you register for
# this purpose (may be the same bot as TELEGRAM_TOKEN above or a different
# one — see docs/domain/identity.md). Leave unset to disable Telegram login;
# the login button and Profile/Security widget simply don't render.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Must exactly match one of the Allowed URLs registered in BotFather.
TELEGRAM_OIDC_REDIRECT_URI=http://localhost:18090/api/v1/auth/telegram/callback

# ---- Local AI email assistant (Phase 0) ----
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
LLM_CONTEXT_LENGTH=2048
LLM_TEMPERATURE=0.2
LLM_KEEP_ALIVE=0
AI_MAX_CONCURRENCY=1
OLLAMA_MEM_LIMIT=2g
OLLAMA_CPU_LIMIT=1.5
AI_EMAIL_CLASSIFICATION_ENABLED=false
AI_EMAIL_DRAFT_ENABLED=false
AI_EMAIL_SEND_ENABLED=false

# ---- Local AI knowledge ingestion (Phase 2A) ----
KNOWLEDGE_BASE_URL=https://talentcenterddc.nl/
KNOWLEDGE_ALLOWED_DOMAINS=talentcenterddc.nl
# The site's un-prefixed URLs are Russian (hreflang="ru"/x-default); /nl/, /en/, /uk/ are
# translations. Pages under a language prefix other than this one are excluded from indexing
# rather than duplicating the knowledge base per-language.
KNOWLEDGE_CANONICAL_LANGUAGE=ru
OLLAMA_EMBEDDING_MODEL=bge-m3
RAG_TOP_K=4
# Both off by default: each adds an extra model call to every classify→retrieve→draft cycle on
# this deployment's 2 CPU/4 GB VPS. Evaluate the effect first via the "Симуляция письма" admin
# panel (always available there regardless of these flags) before enabling for real emails.
RAG_QUERY_EXPANSION_ENABLED=false
RAG_RERANK_ENABLED=false
# Only used when RAG_RERANK_ENABLED=true and Ollama actually exposes /api/rerank with this model
# pulled — otherwise reranking silently falls back to a bi-encoder (re-embed + cosine) pass.
RAG_RERANK_MODEL=qwen3-reranker:0.6b
# Chunk size/overlap for chunkKnowledgeDocument, in characters (no tokenizer wired up in this
# codebase; ~2-2.5 chars/token for Cyrillic, this deployment's canonical language). Applies to
# every ingestion path (WordPress/sitemap sync, manual file upload, manual URL crawl) — none of
# them override the defaults per call.
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
# RAG v2 — layered retrieval (business rules → current facts → FAQ → style examples) over
# server/knowledge/ddc-knowledge-v2. v1 stays the default; switch to v2 only after
# `npm run knowledge:index` + evaluation. Rollback = set back to v1 (v1 chunks are untouched).
RAG_VERSION=v1
RAG_KNOWLEDGE_PATH=knowledge/ddc-knowledge-v2
RAG_RULE_LIMIT=3
RAG_FACT_LIMIT=4
RAG_FAQ_LIMIT=2
RAG_EXAMPLE_LIMIT=2
# RAG v2 prompt budget (tokens) when the selected draft provider is OpenAI. Independent of
# LLM_CONTEXT_LENGTH, which stays the local Ollama num_ctx.
OPENAI_CONTEXT_LENGTH=16000
KNOWLEDGE_SYNC_ENABLED=false
