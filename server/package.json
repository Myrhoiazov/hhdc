        "test:auth": "node --test -r ts-node/register src/modules/crm/security.test.ts src/modules/crm/http.test.ts",
        "test:ci": "node --test -r ts-node/register src/modules/**/*.test.ts src/modules/*/*/*.test.ts src/integrations/**/*.test.ts src/integrations/*/*/*.test.ts src/common/*/*.test.ts",
        "start": "node build/src/index.js",
        "start:worker": "node build/src/worker.js",
        "start:dev": "nodemon",
        "prisma:generate": "prisma generate --schema prisma/schema",
        "prisma:seed": "prisma db seed",
        "seed:choreographers-demo": "ts-node --files prisma/seed-choreographers-demo.ts",
        "seed:choreographers-demo:reset": "ts-node --files prisma/seed-choreographers-demo.ts --reset",
        "migrate:dev": "prisma migrate dev --schema prisma/schema",
        "migrate:prod": "prisma migrate deploy --schema prisma/schema"
    },
