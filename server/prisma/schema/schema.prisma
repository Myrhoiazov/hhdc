datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm, pgcrypto]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum PersonSource {
  MANUAL
  WEEZTIX
  EMAIL
  IMPORT
  SYSTEM
}

enum PersonStatus {
  ACTIVE
  ARCHIVED
}

enum PersonRoleType {
  CUSTOMER
  PARTICIPANT
  CHOREOGRAPHER
  STAFF
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ChoreographerStatus {
  INVITED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TravelStatus {
  NOT_REQUIRED
  PENDING
  BOOKED
  CANCELLED
}

enum HotelStatus {
  NOT_REQUIRED
  PENDING
  BOOKED
  CANCELLED
}

enum DocumentType {
  CONTRACT
  INVOICE
  OTHER
  RIDER
  TRAVEL
  HOTEL
}

enum DocumentStatus {
  DRAFT
  SENT
  SIGNED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CANCELLED
  NO_SHOW
}

enum RegistrationSource {
  MANUAL
  WEEZTIX
  IMPORT
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  REFUNDED
  TRANSFERRED
}

enum ProviderType {
  TICKETING
  EMAIL
  AI
  STORAGE
  PAYMENT
  MESSAGING
  SIGNATURE
}

enum ProviderName {
  WEEZTIX
  GMAIL
  IMAP
  OPENAI
  OLLAMA
  MOLLIE
  GOOGLE_DRIVE
}

enum ProviderStatus {
  DISCONNECTED
  CONNECTED
  ERROR
  DISABLED
}

enum ConversationStatus {
  OPEN
  WAITING
  RESOLVED
  SPAM
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageChannel {
  EMAIL
}

enum AiDraftStatus {
  GENERATED
  EDITED
  APPROVED
  REJECTED
  SENDING
  SENT
  FAILED
}

enum KnowledgeScope {
  GLOBAL
  EVENT
}

enum KnowledgeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum JobType {
  WEEZTIX_SYNC
  EMAIL_SYNC
  AI_DRAFT
  KNOWLEDGE_EMBED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
  OPENED
  CLICKED
}

model User {
  id            String            @id @default(uuid()) @db.Uuid
  email         String            @unique
  passwordHash  String
  name          String
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(6)
  roles         UserRole[]
  sessions      Session[]
  conversations Conversation[]
  tasks         Task[]
  notifications Notification[]
  savedViews    SavedView[]
  eventAccess   UserEventAccess[]
  telegramNotificationChanges TelegramNotificationSetting[]
}

// An address that must not become a contact by itself: its contact was deleted by staff. Letters
// from it are still received; they stay in the mailbox without a person.
model EmailContactBlock {
  address     String   @id
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
}

// The switch of one Telegram notification. The list of notifications and their defaults lives in
// code: a row exists only after somebody changed a switch.
model TelegramNotificationSetting {
  key         String   @id @db.VarChar(64)
  enabled     Boolean
  // The text staff wrote for the message; empty while the text from the code is used.
  template    String?
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Person {
  id                       String                @id @default(uuid()) @db.Uuid
  firstName                String
  lastName                 String
  displayName              String
  email                    String?
  phone                    String?
  birthDate                DateTime?             @db.Date
  language                 String?
  country                  String?
  notes                    String?
  source                   PersonSource          @default(MANUAL)
  status                   PersonStatus          @default(ACTIVE)
  createdAt                DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime              @updatedAt @db.Timestamptz(6)
  roles                    PersonRole[]
  tags                     PersonTag[]
  registrations            Registration[]
  choreographerAssignments EventChoreographer[]
  orders                   Order[]
  tickets                  Ticket[]
  conversations            Conversation[]
  activities               Activity[]
  choreographerProfile     ChoreographerProfile?
  choreographerMedia       ChoreographerMedia[]
  choreographerNotes       ChoreographerNote[]
  conversationLinks        ChoreographerConversationLink[]
  choreographerContacts    ChoreographerContact[]
  choreographerBios        ChoreographerBioVersion[]
  deliveryLogs             DeliveryLog[]
  mergedIntoId             String?               @db.Uuid
  consents                 Consent[]
  payments                 Payment[]
  refunds                  Refund[]
  eventExpenses            EventExpense[]

  @@index([email])
  @@index([phone])
  @@index([status, createdAt])
}

model PersonRole {
  id        String         @id @default(uuid()) @db.Uuid
  personId  String         @db.Uuid
  role      PersonRoleType
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  person    Person         @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, role])
}

model Tag {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  slug        String      @unique
  description String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)
  people      PersonTag[]
}

model PersonTag {
  personId  String   @db.Uuid
  tagId     String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([personId, tagId])
}

model Event {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String
  slug               String               @unique
  description        String?
  status             EventStatus          @default(DRAFT)
  startAt            DateTime             @db.Timestamptz(6)
  endAt              DateTime             @db.Timestamptz(6)
  timezone           String
  venueName          String?
  address            String?
  city               String?
  country            String?
  capacity           Int?
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(6)
  registrations      Registration[]
  choreographers     EventChoreographer[]
  orders             Order[]
  tickets            Ticket[]
  conversations      Conversation[]
  knowledgeDocuments KnowledgeDocument[]
  activities         Activity[]
  sessions           EventSession[]
  ticketTypes        TicketType[]
  expenses           EventExpense[]
  brandId            String?              @db.Uuid
  brand              Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  userAccess         UserEventAccess[]

  @@index([status, startAt])
  @@index([startAt])
}

model EventChoreographer {
  id           String                      @id @default(uuid()) @db.Uuid
  eventId      String                      @db.Uuid
  personId     String                      @db.Uuid
  roleTitle    String
  bioOverride  String?
  status       ChoreographerStatus         @default(INVITED)
  travelStatus TravelStatus                @default(PENDING)
  hotelStatus  HotelStatus                 @default(PENDING)
  notes        String?
  createdAt    DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                    @updatedAt @db.Timestamptz(6)
  event        Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person       Person                      @relation(fields: [personId], references: [id], onDelete: Restrict)
  sessions     EventSessionChoreographer[]
  costs        ChoreographerCost[]
  feeAgreements ChoreographerFeeAgreement[]
  payoutRecords ChoreographerPaymentRecord[]

  @@unique([eventId, personId])
}

model Registration {
  id                 String              @id @default(uuid()) @db.Uuid
  eventId            String              @db.Uuid
  personId           String              @db.Uuid
  ticketId           String?             @unique @db.Uuid
  qrToken            String?             @unique
  status             RegistrationStatus  @default(PENDING)
  registrationSource RegistrationSource  @default(MANUAL)
  notes              String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  event              Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person             Person              @relation(fields: [personId], references: [id], onDelete: Restrict)
  ticket             Ticket?             @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  attendance         SessionAttendance[]

  @@unique([eventId, personId])
  @@index([personId])
  @@index([status])
}

model ProviderConnection {
  id                   String             @id @default(uuid()) @db.Uuid
  type                 ProviderType
  provider             ProviderName
  name                 String
  status               ProviderStatus     @default(DISCONNECTED)
  credentialsEncrypted String?
  settings             Json               @default("{}")
  lastSyncAt           DateTime?          @db.Timestamptz(6)
  lastAttemptAt        DateTime?          @db.Timestamptz(6)
  lastSuccessAt        DateTime?          @db.Timestamptz(6)
  lastFailureAt        DateTime?          @db.Timestamptz(6)
  lastError            String?
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(6)
  orders               Order[]
  tickets              Ticket[]
  messages             Message[]
  externalIdentities   ExternalIdentity[]
  jobs                 Job[]
  syncRuns             SyncRun[]
  campaigns            Campaign[]
  ticketTypes          TicketType[]
  coupons              Coupon[]
}

model Order {
  id                   String              @id @default(uuid()) @db.Uuid
  eventId              String?             @db.Uuid
  buyerPersonId        String?             @db.Uuid
  providerConnectionId String?             @db.Uuid
  externalId           String?
  status               OrderStatus         @default(PENDING)
  currency             String              @default("EUR") @db.VarChar(3)
  subtotal             Decimal             @db.Decimal(14, 2)
  fees                 Decimal             @db.Decimal(14, 2)
  total                Decimal             @db.Decimal(14, 2)
  orderedAt            DateTime            @db.Timestamptz(6)
  shopName             String?
  answers              Json?
  downloadUrl          String?
  rawData              Json?
  // When the chat was told about this order, or when it was decided not to tell. Empty: not yet.
  announcedAt          DateTime?           @db.Timestamptz(6)
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(6)
  event                Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  buyer                Person?             @relation(fields: [buyerPersonId], references: [id], onDelete: SetNull)
  providerConnection   ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  tickets              Ticket[]
  payments             Payment[]

  @@unique([providerConnectionId, externalId])
  @@index([buyerPersonId])
  @@index([orderedAt])
  @@index([eventId, status])
}

model OrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  name       String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(14, 2)
  totalPrice Decimal  @db.Decimal(14, 2)
  externalId String?
  rawData    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tickets    Ticket[]

  @@unique([orderId, externalId])
}

model Ticket {
  id                   String              @id @default(uuid()) @db.Uuid
  orderId              String              @db.Uuid
  orderItemId          String?             @db.Uuid
  eventId              String?             @db.Uuid
  holderPersonId       String?             @db.Uuid
  providerConnectionId String?             @db.Uuid
  externalId           String?
  ticketType           String
  barcode              String?
  price                Decimal?            @db.Decimal(14, 2)
  listPrice            Decimal?            @db.Decimal(14, 2)
  couponCode           String?
  serviceFee           Decimal?            @db.Decimal(14, 2)
  downloadUrl          String?
  status               TicketStatus        @default(VALID)
  rawData              Json?
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(6)
  order                Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem            OrderItem?          @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  event                Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  holder               Person?             @relation(fields: [holderPersonId], references: [id], onDelete: SetNull)
  providerConnection   ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)
  registration         Registration?

  @@unique([providerConnectionId, externalId])
  @@index([holderPersonId])
  @@index([status])
  @@index([eventId, status])
}

// What an event sells and for how much. Read from the ticketing provider, never edited in the CRM.
model TicketType {
  id                   String              @id @default(uuid()) @db.Uuid
  eventId              String              @db.Uuid
  providerConnectionId String?             @db.Uuid
  externalId           String?
  name                 String
  description          String?
  price                Decimal             @db.Decimal(14, 2)
  currency             String              @default("EUR") @db.VarChar(3)
  vatPercentage        Decimal?            @db.Decimal(5, 2)
  status               String
  availableFrom        DateTime?           @db.Timestamptz(6)
  availableUntil       DateTime?           @db.Timestamptz(6)
  soldCount            Int                 @default(0)
  rawData              Json?
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(6)
  event                Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  providerConnection   ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)

  @@unique([providerConnectionId, externalId])
  @@index([eventId])
}

// A discount of the ticketing provider and the codes that grant it. Read-only in the CRM.
model Coupon {
  id                   String              @id @default(uuid()) @db.Uuid
  providerConnectionId String?             @db.Uuid
  externalId           String?
  name                 String
  description          String?
  type                 String
  amount               Decimal?            @db.Decimal(14, 2)
  status               String
  startsAt             DateTime?           @db.Timestamptz(6)
  endsAt               DateTime?           @db.Timestamptz(6)
  codes                String[]
  rawData              Json?
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(6)
  providerConnection   ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)

  @@unique([providerConnectionId, externalId])
}

// What an event costs, entered on the event: fees, salaries, venue, travel and anything else.
// The payee is any person of the CRM (a choreographer, a staff member) or nobody, for a cost
// that is not paid to a person. Expenses recorded on a choreographer's card stay there and are
// added to these in every report.
model EventExpense {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @db.Uuid
  personId    String?   @db.Uuid
  category    String
  description String?
  amount      Decimal   @db.Decimal(14, 2)
  currency    String    @default("EUR") @db.VarChar(3)
  status      String    @default("PLANNED")
  expenseDate DateTime? @db.Date
  paidAt      DateTime? @db.Timestamptz(6)
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person      Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([personId])
}

model Payment {
  id                   String    @id @default(uuid()) @db.Uuid
  orderId              String?   @db.Uuid
  personId             String?   @db.Uuid
  providerConnectionId String?   @db.Uuid
  amount               Decimal   @db.Decimal(14, 2)
  currency             String    @db.VarChar(3)
  status               String
  method               String?
  externalId           String?
  paidAt               DateTime? @db.Timestamptz(6)
  failedAt             DateTime? @db.Timestamptz(6)
  metadata             Json      @default("{}")
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)
  order                Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  person               Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  refunds              Refund[]

  @@unique([orderId, externalId])
  @@index([personId])
  @@index([status, createdAt])
}

model ExternalIdentity {
  id                   String             @id @default(uuid()) @db.Uuid
  providerConnectionId String             @db.Uuid
  entityType           String
  entityId             String             @db.Uuid
  externalId           String
  metadata             Json?
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(6)
  providerConnection   ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)

  @@unique([providerConnectionId, entityType, externalId])
  @@index([entityType, entityId])
}

model Conversation {
  id             String             @id @default(uuid()) @db.Uuid
  personId       String?            @db.Uuid
  eventId        String?            @db.Uuid
  subject        String
  status         ConversationStatus @default(OPEN)
  priority       String             @default("NORMAL")
  assignedUserId String?            @db.Uuid
  lastMessageAt  DateTime           @default(now()) @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)
  person         Person?            @relation(fields: [personId], references: [id], onDelete: SetNull)
  event          Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  assignedUser   User?              @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages       Message[]
  drafts         AiDraft[]
  choreographerLinks ChoreographerConversationLink[]

  @@index([personId])
  @@index([eventId])
  @@index([status, lastMessageAt])
}

model Message {
  id                   String              @id @default(uuid()) @db.Uuid
  conversationId       String              @db.Uuid
  direction            MessageDirection
  channel              MessageChannel      @default(EMAIL)
  sender               String
  recipient            String
  subject              String?
  bodyText             String
  bodyHtml             String?
  externalId           String?
  providerConnectionId String?             @db.Uuid
  receivedAt           DateTime?           @db.Timestamptz(6)
  sentAt               DateTime?           @db.Timestamptz(6)
  rawData              Json?
  classification       Json?
  // Read state of the mailbox message: an inbound message stays unread until someone opens
  // the conversation; outbound messages are recorded as already read.
  isRead               Boolean             @default(false)
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  conversation         Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  providerConnection   ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)
  drafts               AiDraft[]
  attachments          MessageAttachment[]

  @@unique([providerConnectionId, externalId])
  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  messageId   String   @db.Uuid
  filename    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model AiDraft {
  id                 String        @id @default(uuid()) @db.Uuid
  conversationId     String        @db.Uuid
  sourceMessageId    String        @db.Uuid
  status             AiDraftStatus @default(GENERATED)
  language           String
  intent             String
  confidence         Float?
  model              String
  promptVersion      String
  content            String
  contextSnapshot    Json
  createdBy          String        @default("SYSTEM")
  approvedBy         String?       @db.Uuid
  approvedAt         DateTime?     @db.Timestamptz(6)
  sendIdempotencyKey String?       @unique
  sendError          String?
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(6)
  conversation       Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessage      Message       @relation(fields: [sourceMessageId], references: [id], onDelete: Restrict)

  @@index([conversationId, status])
}

model KnowledgeDocument {
  id         String                     @id @default(uuid()) @db.Uuid
  title      String
  scope      KnowledgeScope             @default(GLOBAL)
  eventId    String?                    @db.Uuid
  content    String
  status     KnowledgeStatus            @default(DRAFT)
  sourceType String                     @default("MANUAL")
  sourceUrl  String?
  createdAt  DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime                   @updatedAt @db.Timestamptz(6)
  event      Event?                     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  chunks     KnowledgeChunk[]
  visibility KnowledgeVisibility        @default(INTERNAL)
  versions   KnowledgeDocumentVersion[]

  @@index([scope, eventId, status])
}

model KnowledgeChunk {
  id         String                 @id @default(uuid()) @db.Uuid
  documentId String                 @db.Uuid
  content    String
  position   Int
  embedding  Unsupported("vector")?
  metadata   Json                   @default("{}")
  createdAt  DateTime               @default(now()) @db.Timestamptz(6)
  document   KnowledgeDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, position])
}

model Activity {
  id          String   @id @default(uuid()) @db.Uuid
  personId    String?  @db.Uuid
  eventId     String?  @db.Uuid
  actorUserId String?  @db.Uuid
  type        String
  entityType  String
  entityId    String?  @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  person      Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([personId, createdAt])
  @@index([eventId, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?  @db.Uuid
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

model Job {
  id                   String              @id @default(uuid()) @db.Uuid
  type                 JobType
  status               JobStatus           @default(PENDING)
  providerConnectionId String?             @db.Uuid
  payload              Json                @default("{}")
  attempts             Int                 @default(0)
  maxAttempts          Int                 @default(3)
  runAfter             DateTime            @default(now()) @db.Timestamptz(6)
  startedAt            DateTime?           @db.Timestamptz(6)
  finishedAt           DateTime?           @db.Timestamptz(6)
  error                String?
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(6)
  providerConnection   ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)

  @@index([status, runAfter])
}

model SyncRun {
  id                   String             @id @default(uuid()) @db.Uuid
  providerConnectionId String             @db.Uuid
  type                 JobType
  status               JobStatus          @default(RUNNING)
  startedAt            DateTime           @default(now()) @db.Timestamptz(6)
  finishedAt           DateTime?          @db.Timestamptz(6)
  createdCount         Int                @default(0)
  updatedCount         Int                @default(0)
  skippedCount         Int                @default(0)
  failedCount          Int                @default(0)
  errorSummary         String?
  metadata             Json               @default("{}")
  providerConnection   ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)

  @@index([providerConnectionId, startedAt])
}

enum OutboxEventStatus {
  PENDING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id        String            @id @default(uuid()) @db.Uuid
  topic     String
  payload   Json
  status    OutboxEventStatus @default(PENDING)
  error     String?
  attempts  Int               @default(0)
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?  @db.Timestamptz(6)
  assigneeId  String?    @db.Uuid
  eventId     String?    @db.Uuid
  personId    String?    @db.Uuid
  priority    String     @default("NORMAL")
  createdBy   String?    @db.Uuid
  // Set when the due-date reminder was sent, so it is sent once.
  reminderSentAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  assignee    User?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([assigneeId])
  @@index([status])
  @@index([personId])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  title     String
  message   String?
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model Venue {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String?
  city      String?
  country   String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  rooms     Room[]
}

model Room {
  id        String         @id @default(uuid()) @db.Uuid
  venueId   String         @db.Uuid
  name      String
  capacity  Int?
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)
  venue     Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sessions  EventSession[]
}

model EventSession {
  id             String                      @id @default(uuid()) @db.Uuid
  eventId        String                      @db.Uuid
  roomId         String?                     @db.Uuid
  name           String
  description    String?
  startAt        DateTime                    @db.Timestamptz(6)
  endAt          DateTime                    @db.Timestamptz(6)
  capacity       Int?
  createdAt      DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                    @updatedAt @db.Timestamptz(6)
  event          Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  room           Room?                       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  choreographers EventSessionChoreographer[]
  attendance     SessionAttendance[]

  @@index([eventId, startAt])
}

model EventSessionChoreographer {
  sessionId       String             @db.Uuid
  choreographerId String             @db.Uuid
  session         EventSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  choreographer   EventChoreographer @relation(fields: [choreographerId], references: [id], onDelete: Cascade)

  @@id([sessionId, choreographerId])
}

model SessionAttendance {
  id             String       @id @default(uuid()) @db.Uuid
  sessionId      String       @db.Uuid
  registrationId String       @db.Uuid
  checkedInAt    DateTime     @default(now()) @db.Timestamptz(6)
  session        EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([sessionId, registrationId])
}

// An internal note about a choreographer. Never shown outside the CRM; removing one keeps the row.
model ChoreographerNote {
  id           String    @id @default(uuid()) @db.Uuid
  personId     String    @db.Uuid
  assignmentId String?   @db.Uuid
  content      String
  isPinned     Boolean   @default(false)
  createdById  String    @db.Uuid
  updatedById  String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)
  person       Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, deletedAt, isPinned])
}

enum ConversationLinkReason {
  DIRECT_EMAIL
  MANUAL
  PROVIDER_REFERENCE
}

// An explicit statement that a conversation concerns a choreographer although it is not their
// own thread (for example mail from a manager who represents several people). Links are made
// and removed by staff only, with a reason; nothing is inferred from a shared address.
model ChoreographerConversationLink {
  id             String                 @id @default(uuid()) @db.Uuid
  conversationId String                 @db.Uuid
  personId       String                 @db.Uuid
  assignmentId   String?                @db.Uuid
  linkReason     ConversationLinkReason @default(MANUAL)
  note           String?
  createdById    String?                @db.Uuid
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  removedAt      DateTime?              @db.Timestamptz(6)
  removedById    String?                @db.Uuid
  removalNote    String?
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  person         Person                 @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, removedAt])
  @@index([conversationId])
}

enum ExpensePaidBy {
  ORGANIZER
  CHOREOGRAPHER
  OTHER
}

enum FeeAgreementStatus {
  PROPOSED
  COUNTERED
  AGREED
  SUPERSEDED
  CANCELLED
}

enum FeeBasis {
  EVENT
  SESSION
  DAY
  OTHER
}

// One step of a fee negotiation. Rows are never rewritten: a new offer is a new row, so the
// history of what was proposed and agreed stays intact.
model ChoreographerFeeAgreement {
  id                    String             @id @default(uuid()) @db.Uuid
  assignmentId          String             @db.Uuid
  status                FeeAgreementStatus
  amount                Decimal            @db.Decimal(12, 2)
  currency              String             @db.Char(3)
  feeBasis              FeeBasis           @default(EVENT)
  scopeDescription      String?
  agreedAt              DateTime?          @db.Timestamptz(6)
  notes                 String?
  supersedesAgreementId String?            @db.Uuid
  createdById           String             @db.Uuid
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  assignment            EventChoreographer @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, createdAt(sort: Desc)])
}

enum ChoreographerPaymentType {
  ADVANCE
  FEE
  REIMBURSEMENT
  OTHER
}

enum ChoreographerPaymentStatus {
  PLANNED
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

// A payment to a choreographer as tracked by staff. It records that money moved; it does not
// move it. Ticket revenue lives in `Payment` and is a different ledger.
model ChoreographerPaymentRecord {
  id                String                     @id @default(uuid()) @db.Uuid
  assignmentId      String                     @db.Uuid
  agreementId       String?                    @db.Uuid
  amount            Decimal                    @db.Decimal(12, 2)
  currency          String                     @db.Char(3)
  type              ChoreographerPaymentType
  status            ChoreographerPaymentStatus @default(PLANNED)
  paymentDate       DateTime?                  @db.Date
  reference         String?
  invoiceDocumentId String?                    @db.Uuid
  recordedById      String                     @db.Uuid
  confirmedById     String?                    @db.Uuid
  createdAt         DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @db.Timestamptz(6)
  assignment        EventChoreographer         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, status, paymentDate])
}

// A file kept in private storage. Only the storage module reads `key`; it is never sent to a browser.
model StorageObject {
  id               String   @id @default(uuid()) @db.Uuid
  provider         String   @default("LOCAL")
  key              String   @unique
  originalFilename String
  mimeType         String
  bytes            Int
  sha256           String
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
}

enum MediaRightsStatus {
  UNKNOWN
  PERMITTED
  RESTRICTED
}

// A choreographer photo: the private original plus two derived, metadata-free variants.
model ChoreographerMedia {
  id               String            @id @default(uuid()) @db.Uuid
  personId         String            @db.Uuid
  originalObjectId String            @db.Uuid
  displayObjectId  String            @db.Uuid
  thumbObjectId    String            @db.Uuid
  position         Int
  isCover          Boolean           @default(false)
  caption          String?
  credit           String?
  rightsStatus     MediaRightsStatus @default(UNKNOWN)
  rightsNotes      String?
  width            Int
  height           Int
  createdById      String            @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  deletedAt        DateTime?         @db.Timestamptz(6)
  person           Person            @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, deletedAt, position])
}

enum ChoreographerContactKind {
  SELF_SECONDARY
  MANAGER
  AGENT
  ASSISTANT
  ACCOUNTING
  OTHER
}

// An additional way to reach a choreographer: their own second address, or a third party who
// represents them. A third party's address never proves that a thread belongs to this person.
model ChoreographerContact {
  id               String                   @id @default(uuid()) @db.Uuid
  personId         String                   @db.Uuid
  contactPersonId  String?                  @db.Uuid
  kind             ChoreographerContactKind
  name             String?
  organization     String?
  email            String?
  phone            String?
  locale           String?
  preferredChannel String?
  isPrimary        Boolean                  @default(false)
  isActive         Boolean                  @default(true)
  validFrom        DateTime?                @db.Date
  validTo          DateTime?                @db.Date
  notes            String?
  createdAt        DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(6)
  person           Person                   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, kind, isActive])
  @@index([email])
}

enum ChoreographerBioKind {
  SHORT
  FULL
  PROMO
}

// Biography variants per language. Versions are immutable; exactly one is current per variant.
model ChoreographerBioVersion {
  id          String               @id @default(uuid()) @db.Uuid
  personId    String               @db.Uuid
  locale      String               @db.VarChar(8)
  kind        ChoreographerBioKind
  content     String
  version     Int
  isCurrent   Boolean              @default(true)
  createdById String               @db.Uuid
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  person      Person               @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, locale, kind, version])
  @@index([personId, isCurrent])
}

// Where the working relationship with a choreographer stands, independent of any single event.
enum ChoreographerRelationshipStatus {
  NEW
  CONTACTED
  NEGOTIATING
  ACTIVE
  RETURNING
  INACTIVE
  DO_NOT_CONTACT
}

model ChoreographerProfile {
  id                 String                          @id @default(uuid()) @db.Uuid
  personId           String                          @unique @db.Uuid
  // Legacy V2 fields, kept until the old /choreographers/profile endpoint is retired.
  bio                String?
  socialLinks        Json?
  agencyName         String?
  stageName          String?
  bioShort           String?
  bioFull            String?
  countryCode        String?                         @db.VarChar(2)
  city               String?
  timezone           String?
  relationshipStatus ChoreographerRelationshipStatus @default(NEW)
  websiteUrl         String?
  instagramUrl       String?
  tiktokUrl          String?
  youtubeUrl         String?
  styles             String[]                        @default([])
  languages          String[]                        @default([])
  updatedById        String?                         @db.Uuid
  createdAt          DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                        @updatedAt @db.Timestamptz(6)
  person             Person                          @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([relationshipStatus])
}

model ChoreographerCost {
  id                   String             @id @default(uuid()) @db.Uuid
  eventChoreographerId String             @db.Uuid
  type                 String
  amount               Decimal            @db.Decimal(14, 2)
  currency             String             @default("EUR") @db.VarChar(3)
  description          String?
  status               String             @default("PLANNED")
  documentId           String?            @db.Uuid
  // V2.1: an expense is planned first and known later. `amount` stays the figure the event
  // finance overview reads: the actual amount once known, the estimate until then.
  estimatedAmount      Decimal?           @db.Decimal(14, 2)
  actualAmount         Decimal?           @db.Decimal(14, 2)
  paidBy               ExpensePaidBy      @default(ORGANIZER)
  reimbursable         Boolean            @default(false)
  expenseDate          DateTime?          @db.Date
  createdById          String?            @db.Uuid
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(6)
  eventChoreographer   EventChoreographer @relation(fields: [eventChoreographerId], references: [id], onDelete: Cascade)
}

model DocumentTemplate {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  type      DocumentType
  content   String
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)
  documents Document[]
}

model Document {
  id         String            @id @default(uuid()) @db.Uuid
  templateId String?           @db.Uuid
  entityType String
  entityId   String            @db.Uuid
  type       DocumentType
  status     DocumentStatus    @default(DRAFT)
  title      String
  content    String?
  fileUrl    String?
  metadata   Json?
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(6)
  // V2.1 file documents: the owner is entityType "Person" + entityId; the event and the
  // assignment are optional context, so one document shows up on both screens.
  eventId        String?           @db.Uuid
  assignmentId   String?           @db.Uuid
  currentVersion Int               @default(0)
  notes          String?
  createdById    String?           @db.Uuid
  archivedAt     DateTime?         @db.Timestamptz(6)
  template   DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  versions       DocumentVersion[]
  contract       Contract?
  invoice        Invoice?

  @@index([entityType, entityId])
  @@index([eventId])
  @@index([assignmentId])
}

// One uploaded file of a document. Replacing a file adds a version; earlier ones stay readable.
model DocumentVersion {
  id               String   @id @default(uuid()) @db.Uuid
  documentId       String   @db.Uuid
  version          Int
  storageObjectId  String   @db.Uuid
  originalFilename String
  mimeType         String
  bytes            Int
  checksum         String
  uploadedById     String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
}

enum ContractStatus {
  DRAFT
  READY
  SENT
  SIGNED
  EXPIRED
  CANCELLED
}

// Contracts are signed outside the CRM; this only tracks where one stands.
model Contract {
  id         String         @id @default(uuid()) @db.Uuid
  documentId String         @unique @db.Uuid
  status     ContractStatus @default(DRAFT)
  sentAt     DateTime?      @db.Timestamptz(6)
  signedAt   DateTime?      @db.Timestamptz(6)
  expiresAt  DateTime?      @db.Date
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

enum InvoiceStatus {
  RECEIVED
  REVIEWED
  APPROVED
  PARTIALLY_PAID
  PAID
  CANCELLED
  DISPUTED
}

// An invoice as received. Its status is a staff label: whether it was actually paid is shown
// from the confirmed payment records linked to it, or flagged as marked by hand.
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  documentId    String        @unique @db.Uuid
  invoiceNumber String?
  issuerName    String?
  issueDate     DateTime?     @db.Date
  dueDate       DateTime?     @db.Date
  amount        Decimal?      @db.Decimal(12, 2)
  currency      String?       @db.Char(3)
  status        InvoiceStatus @default(RECEIVED)
  paidManually  Boolean       @default(false)
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([issuerName, invoiceNumber])
}

model CommunicationTemplate {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  subject   String
  bodyHtml  String
  bodyText  String?
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  campaigns Campaign[]
}

model Segment {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  description String?
  filterDsl   Json
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  campaigns   Campaign[]
}

model SavedView {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  name       String
  entityType String
  columns    Json
  sort       Json?
  filterDsl  Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campaign {
  id                   String         @id @default(uuid()) @db.Uuid
  name                 String
  subject              String?
  templateId           String?        @db.Uuid
  segmentId            String         @db.Uuid
  providerConnectionId String?        @db.Uuid
  status               CampaignStatus @default(DRAFT)
  scheduledAt          DateTime?      @db.Timestamptz(6)
  createdAt            DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(6)

  template           CommunicationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  segment            Segment                @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  providerConnection ProviderConnection?    @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  deliveryLogs       DeliveryLog[]

  @@index([status, scheduledAt])
}

model DeliveryLog {
  id          String         @id @default(uuid()) @db.Uuid
  campaignId  String         @db.Uuid
  personId    String         @db.Uuid
  destination String?
  status      DeliveryStatus @default(PENDING)
  error       String?
  sentAt      DateTime?      @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([personId])
}

// ---------------------------------------------------------------------------
// V2 phases 5-9: automation, finance, AI platform, data & platform, hardening
// ---------------------------------------------------------------------------

enum KnowledgeVisibility {
  PUBLIC_OPERATIONAL
  INTERNAL
  FINANCE
  PRIVATE
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutomationRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model Automation {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  status        AutomationStatus   @default(DRAFT)
  triggerType   String
  triggerConfig Json               @default("{}")
  conditions    Json               @default("{}")
  createdBy     String?            @db.Uuid
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)
  actions       AutomationAction[]
  runs          AutomationRun[]

  @@index([status, triggerType])
}

model AutomationAction {
  id           String                @id @default(uuid()) @db.Uuid
  automationId String                @db.Uuid
  position     Int
  type         String
  config       Json                  @default("{}")
  automation   Automation            @relation(fields: [automationId], references: [id], onDelete: Cascade)
  runs         AutomationActionRun[]

  @@unique([automationId, position])
}

model AutomationRun {
  id                String                @id @default(uuid()) @db.Uuid
  automationId      String                @db.Uuid
  triggerType       String
  triggerEntityType String?
  triggerEntityId   String?               @db.Uuid
  status            AutomationRunStatus   @default(RUNNING)
  dryRun            Boolean               @default(false)
  startedAt         DateTime              @default(now()) @db.Timestamptz(6)
  finishedAt        DateTime?             @db.Timestamptz(6)
  error             String?
  context           Json                  @default("{}")
  automation        Automation            @relation(fields: [automationId], references: [id], onDelete: Cascade)
  actionRuns        AutomationActionRun[]

  @@index([automationId, startedAt])
  @@index([status, startedAt])
}

model AutomationActionRun {
  id              String              @id @default(uuid()) @db.Uuid
  automationRunId String              @db.Uuid
  actionId        String?             @db.Uuid
  status          AutomationRunStatus @default(RUNNING)
  input           Json                @default("{}")
  output          Json?
  error           String?
  startedAt       DateTime            @default(now()) @db.Timestamptz(6)
  finishedAt      DateTime?           @db.Timestamptz(6)
  run             AutomationRun       @relation(fields: [automationRunId], references: [id], onDelete: Cascade)
  action          AutomationAction?   @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@index([automationRunId])
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

model Refund {
  id                 String       @id @default(uuid()) @db.Uuid
  paymentId          String       @db.Uuid
  orderId            String?      @db.Uuid
  personId           String?      @db.Uuid
  amount             Decimal      @db.Decimal(14, 2)
  currency           String       @db.VarChar(3)
  reason             String
  status             RefundStatus @default(REQUESTED)
  requestedBy        String       @db.Uuid
  approvedBy         String?      @db.Uuid
  providerExternalId String?
  error              String?
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)
  processedAt        DateTime?    @db.Timestamptz(6)
  payment            Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  person             Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([paymentId])
}

enum AiActionProposalStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
}

model AiActionProposal {
  id         String                 @id @default(uuid()) @db.Uuid
  userId     String                 @db.Uuid
  type       String
  payload    Json
  status     AiActionProposalStatus @default(PENDING)
  expiresAt  DateTime               @db.Timestamptz(6)
  executedAt DateTime?              @db.Timestamptz(6)
  error      String?
  createdAt  DateTime               @default(now()) @db.Timestamptz(6)

  @@index([userId, status])
}

model PromptDefinition {
  id           String   @id @default(uuid()) @db.Uuid
  key          String
  version      Int
  purpose      String
  systemPrompt String
  schema       Json?
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([key, version])
}

model AiEvaluationCase {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  input     Json
  expected  Json
  tags      String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

// One run of the email assistant on a pasted email from the simulation panel: what was asked,
// what each stage decided, and what it cost. Nothing here is ever sent to a customer.
model AiSimulationRun {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  fromAddress   String
  subject       String
  body          String
  status        String
  provider      String?
  model         String?
  promptVersion String?
  result        Json?
  metrics       Json     @default("[]")
  totalTokens   Int      @default(0)
  durationMs    Int
  error         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
}

model AiFeedback {
  id              String   @id @default(uuid()) @db.Uuid
  aiDraftId       String?  @db.Uuid
  aiInteractionId String?  @db.Uuid
  userId          String   @db.Uuid
  rating          String
  reason          String?
  comment         String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([aiDraftId])
}

model KnowledgeDocumentVersion {
  id          String            @id @default(uuid()) @db.Uuid
  documentId  String            @db.Uuid
  version     Int
  content     String
  contentHash String
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
}

enum DuplicateStatus {
  PENDING
  MERGED
  NOT_DUPLICATE
  IGNORED
}

model DuplicateCandidate {
  id         String          @id @default(uuid()) @db.Uuid
  personAId  String          @db.Uuid
  personBId  String          @db.Uuid
  score      Float
  reasons    Json
  status     DuplicateStatus @default(PENDING)
  createdAt  DateTime        @default(now()) @db.Timestamptz(6)
  resolvedAt DateTime?       @db.Timestamptz(6)
  resolvedBy String?         @db.Uuid

  @@unique([personAId, personBId])
  @@index([status, score])
}

model PersonMerge {
  id             String   @id @default(uuid()) @db.Uuid
  sourcePersonId String   @db.Uuid
  targetPersonId String   @db.Uuid
  fieldDecisions Json
  performedBy    String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([targetPersonId])
}

model CustomFieldDefinition {
  id         String             @id @default(uuid()) @db.Uuid
  entityType String
  key        String
  label      String
  type       String
  required   Boolean            @default(false)
  options    Json?
  active     Boolean            @default(true)
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(6)
  values     CustomFieldValue[]

  @@unique([entityType, key])
}

model CustomFieldValue {
  id           String                @id @default(uuid()) @db.Uuid
  definitionId String                @db.Uuid
  entityType   String
  entityId     String                @db.Uuid
  value        Json
  createdAt    DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(6)
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, entityId])
  @@index([entityType, entityId])
}

model Consent {
  id          String    @id @default(uuid()) @db.Uuid
  personId    String    @db.Uuid
  type        String
  status      String
  source      String
  capturedAt  DateTime  @default(now()) @db.Timestamptz(6)
  withdrawnAt DateTime? @db.Timestamptz(6)
  metadata    Json      @default("{}")
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, type])
}

model WebhookEndpoint {
  id              String            @id @default(uuid()) @db.Uuid
  name            String
  url             String
  secretEncrypted String
  status          String            @default("ACTIVE")
  events          Json
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)
  deliveries      WebhookDelivery[]
}

model WebhookDelivery {
  id             String          @id @default(uuid()) @db.Uuid
  endpointId     String          @db.Uuid
  eventType      String
  eventId        String          @db.Uuid
  payload        Json
  status         String          @default("PENDING")
  attempts       Int             @default(0)
  responseStatus Int?
  lastError      String?
  nextRetryAt    DateTime?       @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([status, nextRetryAt])
}

model InboundWebhook {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  externalEventId String
  payloadHash     String
  status          String    @default("RECEIVED")
  receivedAt      DateTime  @default(now()) @db.Timestamptz(6)
  processedAt     DateTime? @db.Timestamptz(6)

  @@unique([provider, externalEventId])
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  keyHash     String    @unique
  prefix      String
  permissions Json
  lastUsedAt  DateTime? @db.Timestamptz(6)
  expiresAt   DateTime? @db.Timestamptz(6)
  status      String    @default("ACTIVE")
  createdBy   String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model Brand {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique
  logo             String?
  defaultEmailFrom String?
  settings         Json     @default("{}")
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)
  events           Event[]
}

model UserEventAccess {
  userId  String @db.Uuid
  eventId String @db.Uuid
  role    String @default("MANAGER")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  userId    String?  @db.Uuid
  ipAddress String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([type, createdAt])
}
