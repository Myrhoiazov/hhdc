enum UserRole {
  ADMIN
  MANAGER
  DOCTOR
}

enum AuthProvider {
  TELEGRAM
  TELEGRAM_MINIAPP
}

enum TelegramAuthFlow {
  LOGIN
  LINK
}

enum AuthSecurityEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGIN_BLOCKED
  LOGIN_TELEGRAM_SUCCEEDED
  LOGIN_TELEGRAM_FAILED
  TELEGRAM_LINKED
  TELEGRAM_UNLINKED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  SESSION_CREATED
  SESSION_ROTATED
  SESSION_REVOKED
  SESSION_REUSE_DETECTED
  ROLE_CHANGED
  ACCOUNT_CREATED
  ACCOUNT_DISABLED
  ACCOUNT_ENABLED
  ACCOUNT_DELETED
  TWO_FACTOR_REQUIRED
  TWO_FACTOR_SUCCEEDED
  TWO_FACTOR_FAILED
  TWO_FACTOR_LOCKED
  TWO_FACTOR_RESENT
  TRUSTED_DEVICE_CREATED
  TRUSTED_DEVICE_REVOKED
  TELEGRAM_ADMIN_STUDENT_CREATED
  TELEGRAM_ADMIN_MOLLIE_CUSTOMER_CREATED
  TELEGRAM_ADMIN_SUBSCRIPTION_CREATED
  TELEGRAM_ADMIN_PAYMENT_LINK_CREATED
  TELEGRAM_MINIAPP_STUDENT_CREATED
}

enum TwoFactorChannel {
  EMAIL
  TELEGRAM // зарезервировано, пока не реализовано
}

enum LoyaltyLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model User {
  id          Int       @id @default(autoincrement())
  firstName   String?
  lastName    String?
  email       String    @unique
  password    String
  salt        String?
  role        UserRole  @default(MANAGER)
  isActive    Boolean   @default(false)
  isEnabled   Boolean   @default(true)
  authVersion Int       @default(0)
  lastLogin   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments                           Comment[]
  sessions                           Session[]
  mollieAccount                      MollieAccount?
  mollieOAuthStates                  MollieOAuthState[]
  resolvedMollieIncidents            MollieIncidentResolution[]
  createdInvoices                    Invoice[]                  @relation("InvoiceCreatedBy")
  updatedInvoices                    Invoice[]                  @relation("InvoiceUpdatedBy")
  invoicePayments                    InvoicePayment[]           @relation("InvoicePaymentCreatedBy")
  invoiceDeliveries                  InvoiceDelivery[]          @relation("InvoiceDeliveryCreatedBy")
  invoiceAuditLogs                   InvoiceAuditLog[]          @relation("InvoiceAuditActor")
  authEventsAsActor                  AuthSecurityEvent[]        @relation("AuthSecurityEventActor")
  authEventsAsTarget                 AuthSecurityEvent[]        @relation("AuthSecurityEventTarget")
  twoFactorChallenges                TwoFactorChallenge[]
  trustedDevices                     TrustedDevice[]
  authIdentities                     AuthIdentity[]
  telegramAuthTransactions           TelegramAuthTransaction[]
  paymentReminderSettingsUpdates     PaymentReminderSettings[]  @relation("PaymentReminderSettingsUpdatedBy")
  paymentReminderDeliveriesTriggered PaymentReminderDelivery[]  @relation("PaymentReminderTriggeredBy")
  paymentReminderTemplateUpdates     PaymentReminderTemplate[]  @relation("PaymentReminderTemplateUpdatedBy")
  aiRuntimeSettingsUpdates           AiRuntimeSettings[]        @relation("AiRuntimeSettingsUpdatedBy")
  telegramNotificationSettingUpdates TelegramNotificationSetting[] @relation("TelegramNotificationSettingUpdatedBy")
  aiSimulationRuns                   AiSimulationRun[]          @relation("AiSimulationRunCreatedBy")

  @@map("users")
}

model Session {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_Id")
  refreshToken String?   @unique @db.VarChar(512)
  tokenHash    String?   @unique @db.VarChar(128)
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  expiresAt    DateTime
  revokedAt    DateTime?
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AuthSecurityEvent {
  id           Int                   @id @default(autoincrement())
  type         AuthSecurityEventType
  actorUserId  Int?                  @map("actor_user_id")
  targetUserId Int?                  @map("target_user_id")
  ipAddress    String?               @db.VarChar(64)
  userAgent    String?               @db.Text
  metadata     Json?
  createdAt    DateTime              @default(now())

  actorUser  User? @relation("AuthSecurityEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuthSecurityEventTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("auth_security_events")
}

// Bridges "password accepted" and "code confirmed" — short-lived and does not
// grant access on its own (unlike Session). One row per in-flight login attempt.
model TwoFactorChallenge {
  id          Int              @id @default(autoincrement())
  userId      Int              @map("user_id")
  channel     TwoFactorChannel @default(EMAIL)
  tokenHash   String           @unique @map("token_hash") @db.VarChar(128)
  codeHash    String           @map("code_hash") @db.VarChar(128)
  attempts    Int              @default(0)
  maxAttempts Int              @default(5) @map("max_attempts")
  resendCount Int              @default(0) @map("resend_count")
  ipAddress   String?          @map("ip_address")
  userAgent   String?          @map("user_agent")
  expiresAt   DateTime         @map("expires_at")
  consumedAt  DateTime?        @map("consumed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at") // bumped on resend — used for the resend cooldown

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_challenges")
}

model TrustedDevice {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trusted_devices")
}

// A Telegram identity explicitly linked to a CRM User. Telegram never creates a
// User — this row only ever appears after an authenticated ADMIN completes the
// link flow. providerUserId is the OIDC subject for TELEGRAM and the numeric
// Telegram user id for TELEGRAM_MINIAPP; usernames are display-only metadata.
model AuthIdentity {
  id             Int          @id @default(autoincrement())
  userId         Int          @map("user_id")
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  username       String?
  displayName    String?      @map("display_name")
  linkedAt       DateTime     @default(now()) @map("linked_at")
  lastLoginAt    DateTime?    @map("last_login_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

// One row per in-flight Telegram OIDC authorization-code+PKCE exchange — same
// role as TwoFactorChallenge: short-lived, single-use, does not grant access by
// itself. userId is set at LINK creation time (bound to the authenticated
// caller server-side, never trusted from the callback) and stays null for LOGIN.
model TelegramAuthTransaction {
  id           Int              @id @default(autoincrement())
  state        String           @unique @db.VarChar(191)
  nonceHash    String           @map("nonce_hash") @db.VarChar(128)
  codeVerifier String           @map("code_verifier") @db.VarChar(191)
  flow         TelegramAuthFlow
  userId       Int?             @map("user_id")
  expiresAt    DateTime         @map("expires_at")
  consumedAt   DateTime?        @map("consumed_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("telegram_auth_transactions")
}
