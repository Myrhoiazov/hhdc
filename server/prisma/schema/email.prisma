model EmailAccount {
  id                Int       @id @default(autoincrement())
  label             String
  imapHost          String    @map("imap_host")
  imapPort          Int       @map("imap_port")
  imapSecure        Boolean   @default(true) @map("imap_secure")
  smtpHost          String    @map("smtp_host")
  smtpPort          Int       @map("smtp_port")
  smtpSecure        Boolean   @default(true) @map("smtp_secure")
  username          String
  passwordEncrypted String    @map("password_encrypted") @db.Text
  isActive          Boolean   @default(true) @map("is_active")
  trashFolder       String    @default("Trash") @map("trash_folder")
  spamFolder        String    @default("Junk") @map("spam_folder")
  lastSyncedUid     Int?      @map("last_synced_uid")
  lastSyncedAt      DateTime? @map("last_synced_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  messages               EmailMessage[]
  paymentReminderSetting PaymentReminderSettings[]

  @@map("email_accounts")
}

model EmailMessage {
  id                 Int      @id @default(autoincrement())
  mailboxId          Int      @map("mailbox_id")
  imapUid            Int?     @map("imap_uid")
  messageId          String?  @map("message_id")
  inReplyToMessageId String?  @map("in_reply_to_message_id")
  isOutgoing         Boolean  @default(false) @map("is_outgoing")
  fromAddress        String   @map("from_address")
  fromName           String?  @map("from_name")
  // Reply-To header when it differs from From. A website contact form sends as the site
  // (wordpress@…) and puts the visitor here; replies and CRM matching use it when present.
  replyToAddress     String?  @map("reply_to_address")
  toAddresses        Json     @map("to_addresses")
  ccAddresses        Json?    @map("cc_addresses")
  subject            String?
  bodyText           String?  @map("body_text") @db.Text
  bodyHtml           String?  @map("body_html") @db.Text
  receivedAt         DateTime @map("received_at")
  isRead             Boolean  @default(false) @map("is_read")
  clientId           Int?     @map("client_id")
  createdAt          DateTime @default(now()) @map("created_at")

  mailbox     EmailAccount      @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  client      Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  attachments EmailAttachment[]

  @@unique([mailboxId, imapUid])
  @@index([clientId])
  @@index([fromAddress])
  @@map("email_messages")
}

model EmailAttachment {
  id          Int      @id @default(autoincrement())
  messageId   Int      @map("message_id")
  filename    String
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  storagePath String   @map("storage_path") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  message EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("email_attachments")
}
