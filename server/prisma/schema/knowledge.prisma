enum KnowledgeDocumentStatus {
  PENDING
  ACTIVE
  INACTIVE
  ERROR
}

enum KnowledgeCategory {
  BRAND
  LOCATIONS
  DANCE_STYLES
  CLASSES
  SCHEDULE
  REGISTRATION
  FAQ
  CAMP
  BUSINESS_RULES
  SOURCES
  OTHER
}

model KnowledgeDocument {
  id            String                  @id @db.VarChar(191)
  sourceType    String                  @map("source_type") @db.VarChar(32)
  sourceId      String                  @map("source_id") @db.VarChar(500)
  sourceUrl     String                  @map("source_url") @db.VarChar(500)
  relativePath  String?                 @map("relative_path") @db.VarChar(500)
  folderPath    String?                 @map("folder_path") @db.VarChar(500)
  title         String?                 @db.VarChar(500)
  language      String?                 @db.VarChar(16)
  contentHash   String                  @map("content_hash") @db.VarChar(64)
  content       String                  @db.LongText
  status        KnowledgeDocumentStatus @default(ACTIVE)
  category      KnowledgeCategory       @default(OTHER)
  priority      Int                     @default(0)
  tags          Json                    @default("[]")
  // Retrieval namespace: 'v1' = legacy flat corpus, 'v2' = ddc-knowledge-v2 layered corpus
  // (RAG_VERSION). Each pipeline only ever searches its own namespace.
  kbVersion     String                  @default("v1") @map("kb_version") @db.VarChar(8)
  errorMessage  String?                 @map("error_message") @db.VarChar(500)
  lastSyncedAt  DateTime?               @map("last_synced_at")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  chunks        KnowledgeChunk[]

  @@index([sourceId, status])
  @@index([contentHash])
  @@index([category])
  @@index([kbVersion, status])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id              String            @id @db.VarChar(191)
  documentId      String            @map("document_id") @db.VarChar(191)
  ordinal         Int
  content         String            @db.Text
  embedding       Json
  embeddingModel  String            @map("embedding_model") @db.VarChar(191)
  contentHash     String            @map("content_hash") @db.VarChar(64)
  headingPath     Json              @map("heading_path")
  // RAG v2 chunk metadata (documentKey, section, priority, category, topic, subtopic, city,
  // style, ageGroup, language, dynamic, lastVerified, source). NULL for v1 chunks.
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  document        KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([contentHash])
  @@map("knowledge_chunks")
}
