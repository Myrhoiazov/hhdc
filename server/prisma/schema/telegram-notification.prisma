// On/off switch per Telegram notification type. The list of types and their defaults lives in
// code (notification-settings.service.ts): a row exists only after an admin changes a setting.
model TelegramNotificationSetting {
  key         String   @id @db.VarChar(64)
  enabled     Boolean
  updatedById Int?     @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("TelegramNotificationSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("telegram_notification_settings")
}
